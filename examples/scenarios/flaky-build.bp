# A task that fails the first time and passes the second.
#
# `build` is a task: two steps that succeed or fail as one. The tests fail
# the first time they are run and pass the second, so the task is run again
# from its first step, as a whole, and what follows it waits for that. Watch
# it in the Node view and under Runs: the steps inside are `build.compile`
# and `build.test`.
#
#   mw apply examples/scenarios/flaky-build.bp --project <project>
blueprint: flaky-build
description: A build whose tests fail once, to see a task retried as one.
permissions: [shell]

params:
  marker:
    type: string
    default: ".flaky-build-ran-once"
    description: "A file that says the tests have been run once already."

steps:
  build:
    description: Everything it takes to have something to ship. Tried again, all of it, when any of it fails.
    task:
      compile:
        do: shell
        with: { run: "echo compiling" }

      test:
        do: shell
        with:
          run: |
            if [ -f '${params.marker}' ]; then
              rm '${params.marker}'
              echo "the tests pass"
            else
              touch '${params.marker}'
              echo "the tests fail the first time" >&2
              exit 1
            fi
    retry: 2

  ship:
    description: Only once the whole of the build has held.
    do: shell
    with: { run: "echo 'shipped: ${ steps.build.out.test.stdout ?? '' }'" }
