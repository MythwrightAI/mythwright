{
  "says": "A link that names an issue of the Jira project has a card made for it, filled as the issue stands. Moved to a status Jira counts as done, its card is moved to the board's last column when Jira's call says it changed, and moved back to one not begun, to the first; a card moved to the last column here has its issue moved on by the way to done its workflow offers, and one moved out of it has it moved back. Moves between other columns stay here.",
  "steps": [
    {"run": ["project", "create", "--bare", "Shop"]},
    {"run": ["apply", "std/board", "--project", "shop"]},
    {"run": ["channel", "create", "shop", "--project", "shop"]},
    {"given": {"key.txt": "ada@example.com:t0ken", "signing.txt": "s3cret"}},
    {"run": ["secret", "set", "jira-key", "--file", "{here}/key.txt"]},
    {"given": {"issues/SHOP-1/summary": "Fix the footer", "issues/SHOP-1/description": "It overlaps the cart.", "issues/SHOP-1/updated": "s1"}},
    {"apply": "issues", "project": "shop", "params": {"site": "https://acme.example", "jira_project": "SHOP", "key": "jira-key"}, "sets_off": "look"},
    {"ran": ["{curl} {api}/myself", "{curl} {changed}"]},
    {"run": ["secret", "set", "jira-signing", "--file", "{here}/signing.txt"]},
    {"run": ["caller", "set", "jira", "--topic", "jira.called", "--secret", "jira-signing", "--header", "X-Hub-Signature", "--prefix", "sha256="]},
    {"run": ["record", "add", "shop", "links", "issue=SHOP-1"], "sets_off": "keep"},
    {"ran": ["{curl} {api}/issue/SHOP-1{whole}", "{curl} {api}/issue/SHOP-1{whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "title: Fix the footer"},
    {"run": ["record", "show", "shop-1"], "says": "body: It overlaps the cart."},
    {"run": ["record", "show", "shop-1"], "says": "status: backlog"},
    {"run": ["record", "show", "shop-links-1"], "says": "card: shop-1"},
    {"given": {"issues/SHOP-1/status": "done", "issues/SHOP-1/updated": "s2"}},
    {"call": "jira", "signed": "s3cret", "header": "X-Hub-Signature", "prefix": "sha256=", "body": {"webhookEvent": "jira:issue_updated", "issue": {"key": "SHOP-1", "fields": {"project": {"key": "SHOP"}}}}, "sets_off": "keep"},
    {"ran": ["{curl} {api}/issue/SHOP-1{whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "status: done"},
    {"call": "jira", "signed": "s3cret", "header": "X-Hub-Signature", "prefix": "sha256=", "body": {"webhookEvent": "jira:issue_updated", "issue": {"key": "OTHER-1", "fields": {"project": {"key": "OTHER"}}}}},
    {"given": {"issues/SHOP-1/status": "new", "issues/SHOP-1/updated": "s3"}},
    {"call": "jira", "signed": "s3cret", "header": "X-Hub-Signature", "prefix": "sha256=", "body": {"webhookEvent": "jira:issue_updated", "issue": {"key": "SHOP-1", "fields": {"project": {"key": "SHOP"}}}}, "sets_off": "keep"},
    {"ran": ["{curl} {api}/issue/SHOP-1{whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "status: backlog"},
    {"run": ["board", "move", "shop-1", "ready"]},
    {"run": ["board", "move", "shop-1", "doing"]},
    {"run": ["board", "move", "shop-1", "done"], "sets_off": "keep"},
    {"ran": ["{curl} {api}/issue/SHOP-1{whole}", "{curl} {api}/issue/SHOP-1/transitions", "{curl} {post} {\"transition\":{\"id\":\"31\"}} {api}/issue/SHOP-1/transitions"]},
    {"holds": {"issues/SHOP-1": {"summary": "Fix the footer", "description": "It overlaps the cart.", "status": "done", "updated": "t1"}}},
    {"run": ["board", "move", "shop-1", "review"], "sets_off": "keep"},
    {"ran": ["{curl} {api}/issue/SHOP-1{whole}", "{curl} {api}/issue/SHOP-1/transitions", "{curl} {post} {\"transition\":{\"id\":\"11\"}} {api}/issue/SHOP-1/transitions"]},
    {"holds": {"issues/SHOP-1": {"summary": "Fix the footer", "description": "It overlaps the cart.", "status": "new", "updated": "t2"}}}
  ]
}
