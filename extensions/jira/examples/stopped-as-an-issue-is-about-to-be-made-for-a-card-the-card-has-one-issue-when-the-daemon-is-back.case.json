    {"ran": ["{curl} {api}/myself", "{curl} {changed}"]},
    {"stopped_at": "open", "of": "issues", "by": {"run": ["record", "add", "shop", "links", "card=shop-1"]}, "sets_off": "keep"},
    {"holds": {"issues/SHOP-1": {"summary": "Add a cart", "description": "Customers need one.", "labels": "card-shop-1\n", "updated": "t1"}, "issues/SHOP-2": {}}},
    {"run": ["record", "show", "shop-links-1"], "says": "issue: SHOP-1"},
    {"run": ["record", "show", "shop-links-1"], "says": "agreed_title: Add a cart"}
  ]
