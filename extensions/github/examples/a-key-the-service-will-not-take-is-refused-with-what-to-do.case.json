{
  "says": "A key that GitHub will not take is said when the blueprint is applied, as the key's fault and not as nobody being signed in.",
  "steps": [
    {"run": ["project", "create", "--bare", "Shop"]},
    {"run": ["apply", "std/board", "--project", "shop"]},
    {"run": ["channel", "create", "shop", "--project", "shop"]},
    {"run": ["board", "add", "shop", "Add a cart", "--body", "Customers need one."]},
    {"given": {"token.txt": "tok_that_was_revoked", "bad-key": ""}},
    {"run": ["secret", "set", "shop-bot", "--file", "{here}/token.txt"]},
    {"apply": "pull-requests", "project": "shop", "params": {"key": "shop-bot"}, "fails": "GitHub did not take the key the program `gh` was handed"}
  ]
}
