{
  "says": "A call whose signature the secret does not make is refused, and one that is signed but says an issue of another repository, or something said on a pull request, is passed over: the issue is not read and the card is as it was.",
  "steps": [
    {"run": ["project", "create", "--bare", "Shop"]},
    {"run": ["apply", "std/board", "--project", "shop"]},
    {"run": ["channel", "create", "shop", "--project", "shop"]},
    {"run": ["board", "add", "shop", "Add a cart", "--body", "Customers need one."]},
    {"apply": "issues", "project": "shop", "sets_off": "look"},
    {"given": {"signing.txt": "s3cret"}},
    {"run": ["secret", "set", "hub-signing", "--file", "{here}/signing.txt"]},
    {"run": ["caller", "set", "hub", "--topic", "issues.called", "--secret", "hub-signing", "--header", "X-Hub-Signature-256", "--prefix", "sha256="]},
    {"run": ["record", "add", "shop", "links", "card=shop-1"], "sets_off": "keep"},
    {"ran": ["auth status", "repo view --json=nameWithOwner --jq=.nameWithOwner", "{issues-changed}", "{issues-last} --jq=[.[] | select(.body | contains(\"<!-- card shop-1 -->\"))] | (.[0] // {}) | {number, url}", "issue create --title=Add a cart --body=Customers need one.\\n\\n<!-- card shop-1 -->", "{issues-last} --jq=[.[] | select(.body | contains(\"<!-- card shop-1 -->\"))] | (.[0] // {}) | {number, url}", "api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"given": {"issues/1/title": "Add a trolley", "issues/1/stamp": "s2"}},
    {"call": "hub", "signed": "not the secret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1}, "repository": {"full_name": "acme/shop"}}, "refused": true},
    {"call": "hub", "signed": "s3cret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1}, "repository": {"full_name": "acme/other"}}},
    {"call": "hub", "signed": "s3cret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1, "pull_request": {"url": "https://github.example/acme/shop/pull/1"}}, "repository": {"full_name": "acme/shop"}}},
    {"run": ["emit", "issues.heard", "project=other", "number=1"]},
    {"ran": []},
    {"run": ["record", "show", "shop-1"], "says": "title: Add a cart"}
  ]
}
