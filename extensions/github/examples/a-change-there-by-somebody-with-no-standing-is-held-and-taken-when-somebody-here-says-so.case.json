{
  "says": "Unless told otherwise, a change of an issue's title or body by somebody GitHub does not say has standing in the repository is not taken into the card. The link says that it waits and whose it is, and the card is told once what to do. While it waits neither side's words are written over the other's, and whether it is closed still crosses. Told `take` in the link, what is on GitHub comes in, and the link waits for nothing: the next change by the same hand is held as the first was.",
  "steps": [
    {"run": ["project", "create", "--bare", "Shop"]},
    {"run": ["apply", "std/board", "--project", "shop"]},
    {"run": ["channel", "create", "shop", "--project", "shop"]},
    {"run": ["board", "add", "shop", "Add a cart", "--body", "Customers need one."]},
    {"apply": "issues", "project": "shop", "sets_off": "look"},
    {"given": {"signing.txt": "s3cret"}},
    {"run": ["secret", "set", "hub-signing", "--file", "{here}/signing.txt"]},
    {"run": ["caller", "set", "hub", "--topic", "issues.called", "--secret", "hub-signing", "--header", "X-Hub-Signature-256", "--prefix", "sha256="]},
    {"run": ["record", "add", "shop", "links", "card=shop-1"], "sets_off": "keep"},
    {"ran": ["auth status", "repo view --json=nameWithOwner --jq=.nameWithOwner", "{issues-changed}", "{issues-last} --jq=[.[] | select(.body | contains(\"<!-- card shop-1 -->\"))] | (.[0] // {}) | {number, url}", "issue create --title=Add a cart --body=Customers need one.\\n\\n<!-- card shop-1 -->", "{issues-last} --jq=[.[] | select(.body | contains(\"<!-- card shop-1 -->\"))] | (.[0] // {}) | {number, url}", "api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"given": {"issues/1/author": "mallory", "issues/1/title": "Free money", "issues/1/stamp": "s2"}},
    {"call": "hub", "signed": "s3cret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1}, "repository": {"full_name": "acme/shop"}}, "sets_off": "keep"},
    {"ran": ["api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "title: Add a cart"},
    {"run": ["record", "show", "shop-links-1"], "says": "held: waiting"},
    {"run": ["record", "show", "shop-links-1"], "says": "held_by: mallory"},
    {"run": ["board", "history", "shop-1"], "says": "was changed by mallory, who has no standing in the repository, and was not taken: https://github.example/acme/shop/issues/1"},
    {"run": ["board", "set", "shop-1", "body=They asked twice."], "sets_off": "keep"},
    {"ran": ["api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"given": {"issues/1/state": "CLOSED"}},
    {"call": "hub", "signed": "s3cret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1}, "repository": {"full_name": "acme/shop"}}, "sets_off": "keep"},
    {"ran": ["api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "status: done"},
    {"holds": {"issues/1": {"author": "mallory", "title": "Free money", "body": "Customers need one.\n\n<!-- card shop-1 -->", "state": "CLOSED", "stamp": "s2"}}},
    {"run": ["record", "set", "shop-links-1", "held=take"], "sets_off": "keep"},
    {"ran": ["api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "title: Free money"},
    {"run": ["record", "show", "shop-1"], "says": "body: Customers need one."},
    {"run": ["record", "show", "shop-links-1"], "says": "agreed_title: Free money"},
    {"holds": {"issues/1": {"author": "mallory", "title": "Free money", "body": "Customers need one.\n\n<!-- card shop-1 -->", "state": "CLOSED", "stamp": "s2"}}},
    {"given": {"issues/1/title": "More free money", "issues/1/stamp": "s3"}},
    {"call": "hub", "signed": "s3cret", "header": "X-Hub-Signature-256", "prefix": "sha256=", "body": {"action": "edited", "issue": {"number": 1}, "repository": {"full_name": "acme/shop"}}, "sets_off": "keep"},
    {"ran": ["api graphql -F owner={owner} -F repo={repo} -F number=1 {issue-whole}"]},
    {"run": ["record", "show", "shop-1"], "says": "title: Free money"},
    {"run": ["record", "show", "shop-links-1"], "says": "held: waiting"}
  ]
}
